{
  "name": "tokenpilot",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "Local-first development continuity and agent routing platform for ChatGPT, Codex, and async agent workflows",
  "type": "module",
  "bin": {
    "tokenpilot": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "npm run build:web && tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "dev:cli": "tsx src/cli/index.ts",
    "init": "tsx src/cli/index.ts init",
    "setup": "npm install && npm run init && npm run build",
    "doctor": "tsx src/cli/index.ts doctor",
    "doctor:runtime": "./scripts/doctor-local-runtime.sh",
    "pack": "tsx src/cli/index.ts pack",
    "manifest": "tsx src/cli/index.ts manifest",
    "taskpack": "tsx src/cli/index.ts taskpack",
    "queue-pack": "tsx src/cli/index.ts queue-pack",
    "queue-taskpack": "tsx src/cli/index.ts queue-taskpack",
    "queue-codex-run": "tsx src/cli/index.ts queue-codex-run",
    "jobs": "tsx src/cli/index.ts jobs",
    "job": "tsx src/cli/index.ts job",
    "server": "tsx src/cli/index.ts server",
    "server:dist": "node dist/cli/index.js server",
    "runner": "tsx src/cli/index.ts runner",
    "gpt:instructions": "tsx scripts/generate-gpt-instructions.ts",
    "verify:e2e": "tsx scripts/verify-local-e2e.ts",
    "verify:smoke": "tsx scripts/verify-local-smoke.ts",
    "verify:mcp": "tsx scripts/verify-mcp-smoke.ts",
    "verify:continuity": "tsx scripts/verify-continuity-store.ts",
    "verify:continuity-api": "tsx scripts/verify-continuity-api.ts",
    "verify:continuity-restart": "tsx scripts/verify-continuity-restart.ts",
    "verify:task-completion": "tsx scripts/verify-task-completion.ts",
    "verify:codex-adapter": "tsx scripts/verify-codex-app-server.ts && tsx scripts/verify-codex-runtime-api.ts",
    "verify:codex-execution": "tsx scripts/verify-codex-execution.ts",
    "verify:codex-standalone": "tsx scripts/verify-codex-standalone.ts",
    "verify:chat-direct": "tsx scripts/verify-chat-direct-routing.ts",
    "verify:source-archive": "tsx scripts/verify-source-archive.ts",
    "verify:protocol-core": "npm run verify:mcp && npm run verify:continuity && npm run verify:continuity-api && npm run verify:continuity-restart && npm run verify:task-completion && npm run verify:codex-adapter && npm run verify:codex-execution && npm run verify:codex-standalone && npm run verify:chat-direct",
    "verify:protocol-release": "npm run verify:protocol-core && npm run verify:source-archive",
    "probe:codex-standalone": "tsx scripts/probe-codex-standalone.ts",
    "verify:docs": "tsx scripts/verify-doc-links.ts",
    "verify:web:safety": "tsx scripts/verify-web-safety.ts",
    "verify:release": "npm run verify:protocol-release && ./scripts/verify-release-dry-run.sh",
    "release:source": "./scripts/create-release-source-package.sh",
    "privacy:scan:history": "./scripts/scan-history-privacy.sh",
    "verify:web": "npm run typecheck:web && npm run build:web && npm run verify:web:safety",
    "mvp:start": "./scripts/macos-manage-local-server.sh start",
    "start:local": "./scripts/macos-manage-local-server.sh start",
    "mvp:stop": "./scripts/macos-manage-local-server.sh stop",
    "stop:local": "./scripts/macos-manage-local-server.sh stop",
    "mvp:restart": "./scripts/macos-manage-local-server.sh restart",
    "mvp:status": "./scripts/macos-manage-local-server.sh status",
    "mvp:reset": "./scripts/macos-manage-local-server.sh reset",
    "reset:local": "./scripts/macos-manage-local-server.sh reset",
    "verify": "npm run typecheck && npm run verify:docs && npm run verify:web && npm run doctor && npm run verify:smoke && npm run verify:mcp && npm run verify:continuity && npm run verify:continuity-api && npm run verify:continuity-restart && npm run verify:task-completion && npm run verify:codex-adapter && npm run verify:codex-execution && npm run verify:codex-standalone && npm run verify:chat-direct && npm run verify:e2e"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@lobehub/fluent-emoji": "^4.1.0",
    "@lobehub/icons": "^5.8.0",
    "@lobehub/ui": "^5.14.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.2",
    "antd": "^6.4.2",
    "motion": "^12.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  },
  "overrides": {
    "dompurify": "3.4.13"
  }
}
